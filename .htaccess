# Lomas de Yanamayo I - plano 360° (SiteGround / Apache)
# Subir esta carpeta tal cual a /lomas1/ (o a la raíz de otro dominio).

DirectoryIndex index.html index.htm
Options -Indexes

<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType image/webp .webp
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # La aplicación (index, CRM, datos del tour) siempre se revalida: los cambios se ven al instante.
  <FilesMatch "\.(html?|js|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# tour/media y tour/lib tienen su propio .htaccess con cache largo
# (el player los pide con ?v=<fecha del export>, así que un nuevo export no queda cacheado).
